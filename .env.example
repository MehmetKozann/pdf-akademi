# ==============================================================================
# AKADEMIK AI - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to `.env.local` and fill in your credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE CONFIGURATION (Database, Auth & File Storage)
# ------------------------------------------------------------------------------
# When configured, the platform uses Supabase PostgreSQL + pgvector + Auth + Storage.
# When omitted in local development, the platform automatically uses a real
# persistent server-side file database (.data/) so all features work out-of-the-box.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Local session signing secret (used when running in local persistent mode)
AUTH_SESSION_SECRET=change-this-to-a-secure-random-64-char-secret-in-production

# ------------------------------------------------------------------------------
# 2. AI PROVIDER CONFIGURATION (Server-Side Only — Never Exposed to Frontend)
# ------------------------------------------------------------------------------
# Supported providers: "openai" | "gemini" | "anthropic" | "compatible"
AI_PROVIDER=openai

# Optional model overrides (sensible defaults are chosen per provider if omitted)
# OpenAI defaults: gpt-4o-mini (chat) / text-embedding-3-small (embeddings)
# Gemini defaults: gemini-2.5-flash (chat) / text-embedding-004 (embeddings)
# Anthropic defaults: claude-3-5-sonnet-latest
AI_MODEL=
AI_EMBEDDING_MODEL=

# Provider API Keys (configure at least one matching AI_PROVIDER)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Custom OpenAI-Compatible Endpoint (e.g., Ollama: http://localhost:11434/v1)
AI_BASE_URL=
AI_COMPATIBLE_API_KEY=

# ------------------------------------------------------------------------------
# 3. DOCUMENT PROCESSING & SECURITY LIMITS
# ------------------------------------------------------------------------------
MAX_FILE_SIZE_MB=25
ENABLE_OCR=true
OCR_LANGUAGES=tur+eng

